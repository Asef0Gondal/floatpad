{
  "name": "floatpad",
  "productName": "FloatPad",
  "version": "2.9.9",
  "description": "Lean always-on-top reference pad \u2014 board, video, web and write modes in one floating overlay. Native Rust/Tauri.",
  "author": "Asif Gondal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asef0Gondal/floatpad.git"
  },
  "keywords": [
    "tauri",
    "rust",
    "react",
    "floating-window",
    "overlay",
    "reference-pad",
    "macos",
    "windows",
    "linux",
    "utility"
  ],
  "scripts": {
    "dev:vite": "vite",
    "start": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build": "vite build",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist:win": "tauri build --bundles nsis",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:app": "tauri build",
    "dist:linux": "tauri build --bundles deb,appimage",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}