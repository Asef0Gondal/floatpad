{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and undocked panels: full app IPC",
  "windows": [
    "main",
    "panel-*",
    "shot-*"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "drag:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/Volumes/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "allow-win-close",
    "allow-win-opacity",
    "allow-win-resize",
    "allow-win-detach",
    "allow-win-always-bottom",
    "allow-win-lock",
    "allow-reveal-path",
    "allow-open-external",
    "allow-win-mini-toggle",
    "allow-panel-undock",
    "allow-panel-dock-back",
    "allow-screenshot-request",
    "allow-capture-screen",
    "allow-capture-webview-rect",
    "allow-adblock-site-status",
    "allow-adblock-toggle-site",
    "allow-web-create",
    "allow-web-set-bounds",
    "allow-web-show",
    "allow-web-hide",
    "allow-web-destroy",
    "allow-web-eval",
    "allow-log-js",
    "allow-ocr-image",
    "allow-shot-open",
    "allow-shot-payload",
    "allow-gif-frames",
    "allow-autosave-board",
    "allow-load-autosave-board",
    "opener:default",
    "allow-shot-save",
    "allow-shots-list",
    "allow-shot-load",
    "allow-shot-delete",
    "allow-shot-update",
    "allow-shots-clear",
    "allow-board-autosave-clear",
    "allow-image-optimize",
    "allow-list-md-files",
    "allow-fetch-image-dataurl"
  ]
}