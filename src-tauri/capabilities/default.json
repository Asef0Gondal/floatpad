{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and undocked panels: full app IPC",
  "windows": ["main", "panel-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }] },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "allow-win-close",
    "allow-win-minimize",
    "allow-win-show",
    "allow-show-all",
    "allow-win-opacity",
    "allow-win-resize",
    "allow-win-detach",
    "allow-win-mini-toggle",
    "allow-panel-undock",
    "allow-panel-dock-back",
    "allow-screenshot-request",
    "allow-capture-screen",
    "allow-capture-webview-rect",
    "allow-adblock-site-status",
    "allow-adblock-toggle-site",
    "allow-web-create",
    "allow-web-set-bounds",
    "allow-web-show",
    "allow-web-hide",
    "allow-web-destroy",
    "allow-web-eval"
  ]
}